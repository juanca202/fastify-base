{
  "name": "fastify-base",
  "version": "1.0.0",
  "private": true,
  "description": "Base API First con Fastify, TypeScript, Zod y OpenAPI.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "vitest run test/health.test.ts test/openapi.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "arch": "node scripts/arch/verify.mjs"
  },
  "dependencies": {
    "@fastify/otel": "^0.21.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-zod": "^1.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@scalar/fastify-api-reference": "^1.67.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "openapi-types": "^12.1.3",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
