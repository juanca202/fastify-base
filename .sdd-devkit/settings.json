{
  "language": "es",
  "specification": {
    "changesPath": "docs/specs/changes/",
    "currentPath": "docs/specs/current/",
    "archivedPath": "docs/specs/archived/",
    "testCases": {
      "createMode": "ask",
      "createDetailsMode": "ask"
    }
  },
  "implementation": {
    "confirmByUnit": "always",
    "uncommittedChanges": "ask",
    "workTree": "ask",
    "maxParallel": 3,
    "handoff": "ask"
  },
  "verification": {
    "qualityCheck": {
      "enabled": true,
      "confirmFix": "always"
    },
    "codeReview": {
      "enabled": true,
      "confirmFix": "always"
    },
    "requirementCoverage": {
      "enabled": true,
      "confirmFix": "always"
    },
    "handoff": "ask"
  },
  "git": {
    "commitConfirmation": "always",
    "push": "never",
    "integrationBranches": []
  },
  "projectManagement": {
    "enabled": false
  }
}
